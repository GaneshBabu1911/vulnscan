# ── VulnScan Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Flask
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
FLASK_ENV=development
PORT=5000

# Admin account
ADMIN_PASSWORD=Admin@123456

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# ── MySQL Database (XAMPP / MySQL Workbench) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vulscan_db
DB_USER=root
DB_PASSWORD=

# ── Email (optional – leave blank to disable email features) ──────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@vulnscan.io

# ── OWASP ZAP (optional – leave default if ZAP is not running) ───────────────
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# ── AI Recommendations (local = rule-based, no API key needed) ────────────────
AI_PROVIDER=local
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
